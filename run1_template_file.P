 !DefTopology={Outletbc3Const | #meshfolder/bcout3_const  | 0Basis2D}
   !SetTopology={Outletbc3Const | CreateInBoundary | [TP1;#BC3]}
   !SetTopology={Outletbc3Const | SpatialConstant}

 !DefTopology={OutletConst | #meshfolder/out_const  | 0Basis2D}
   !SetTopology={OutletConst | CreateInBoundary | [TP1;#Outlet]}
   !SetTopology={OutletConst | SpatialConstant}

 !DefInterface={OneToOne | Outletbc1 | Outletbc1Const}
 !DefInterface={OneToOne | Outletbc2 | Outletbc2Const}
 !DefInterface={OneToOne | Outletbc3 | Outletbc3Const}
 !DefInterface={OneToOne | Outlet | OutletConst}

 !DefInterface={ManyToOne | Outletbc1 | TP1 | #meshfolder/outbc1-tp1.IN | NestedInBndry[#BC1]}
 !DefInterface={ManyToOne | Outletbc2 | TP1 | #meshfolder/outbc2-tp1.IN | NestedInBndry[#BC2]}
 !DefInterface={ManyToOne | Outletbc3 | TP1 | #meshfolder/outbc3-tp1.IN | NestedInBndry[#BC3]}
 !DefInterface={ManyToOne | Outlet    | TP1 | #meshfolder/out-tp1.IN  | NestedInBndry[#Outlet]}
 !DefInterface={ManyToOne | WallTP    | TP1 | #meshfolder/tpwall-tp1.IN | NestedInBndry[#BCWall]}
 
!DefTopology={TPD | meshes/mesh_disc | DscBasis}
  !SetTopology={TPD | MakeDiscontinuous}
!DefInterface={OneToOne | TP1 | TPD}

%  Variable Pointers ...
 !DefVariablePointer={X | TP1 | #meshfolder/model | 3}
 !DefVariablePointer={X0 | TP1 | #meshfolder/model | 3}
 !DefVariablePointer={P | TP1 | 1}
   !SetVariablePointer={P | INIT_EXPR | Po_init}
 !DefVariablePointer={V | TP1 | 3}
 !DefVariablePointer={Po | TP1 | 1}
   !SetVariablePointer={Po | TEMPORAL_UPDATE_EXPR | Po_expr}

 !DefVariablePointer={Wel | TP1 | 3 }   
 !DefVariablePointer={Qual   | TPD | 1}  % Stores the element quality  %
 !DefVariablePointer={Estiff | TPD | 1}  % Variable that stores element stiffness

 !DefVariablePointer={Norms | TP1 | meshes/normals.D | 3}

 !DefVariablePointer={InVel | TP1 | 3}
   !SetVariablePointer={InVel | TEMPORAL_UPDATE_EXPR | inlet_expr}

 !DefVariablePointer={LM1 | null_topology | 1 } % Outletbc1Const | 1}
   !SetVariablePointer={LM1 | INIT_EXPR | Po_init}
 !DefVariablePointer={LM2 | null_topology | 1 } %Outletbc2Const | 1}
   !SetVariablePointer={LM2 | INIT_EXPR | Po_init}
 !DefVariablePointer={LM3 | null_topology | 1 } %Outletbc3Const | 1}
   !SetVariablePointer={LM3 | INIT_EXPR | Po_init}
 !DefVariablePointer={LMOut | null_topology | 1 } %OutletConst | 1}
   !SetVariablePointer={LMOut | INIT_EXPR | Po_init}
 !DefVariablePointer = {LMWall | WallTP | 1 } 
   !SetVariablePointer = {LMWall | INIT_EXPR | Po_init}

 !DefDataPointer={inflow | datain/fluxin.D | 2 | 9591}

 !SetExportFrequency={X | V | P | Wel | Qual | 1}
% !SetExportFrequency={LM1 | LM2 | LM3 | LMOut | 10}
 !SetExportFrequency = {X0 | Norms | LMWall | Estiff | InVel | Po | -1}
 
% --- Define Expressions ---------------------------------------------
!DefExpression{influx}
  12 * #stroke_vol / #Ts * t/#Ts * (1 - t/#Ts)^2 * (t < #Ts)

!DefExpression{q1_expr}
  -influx/(#A1_area + #A2_area + #A3_area + #Aout_area)

!DefExpression{Po_init}
  #Po  % 63 mmHg

!DefExpression{Po_expr}
  P - P + Po_init

% --- ALE Problem Specifications ---------------------------------------------
!DefProblem={AleProblem | ale_element_dependent_stiffness}
!UseVariablePointer={Space            | X0    }
!UseVariablePointer={DomainVelocity   | Wel   }
!UseVariablePointer={AleSpace         | X     }
!UseVariablePointer={ElementQuality   | Qual  }
!UseVariablePointer={ElementStiffness | Estiff}

% cut plane domain velocity will not move
!Penalty-parameter={1}
!Radius-ratio-metric
!Boundary-patch-definitions
   #BCWall           Wel  Dirichlet  V            % big wall
   #AorticInletID    Wel  Dirichlet  0 0 0 
   #BC1              Wel  Dirichlet  0 0 0 
   #BC2              Wel  Dirichlet  0 0 0 
   #BC3              Wel  Dirichlet  0 0 0 
   #Outlet           Wel  Dirichlet  0 0 0 

%  --- Fluid Problem Specifications  ------------------------------------------
 !DefProblem={FluidProblem | G2_ALE_NONCON_NAVIER_STOKES_FLOW}
   !UseVariablePointer={Space | X}
   !UseVariablePointer={Velocity | V}     %   
   !UseVariablePointer={DomainVelocity |  Wel }
   !UseVariablePointer={Pressure | P}     %   !True-Navier-Poisson
   !Density={#RHO}
   !Viscosity={#MU}
   !Velocity-scale={#VEL_SCALE}
   !SetRootTopology={TP1}
   !SetProblemTimeDiscretization={time_scheme_backward_euler | midpoint}
   !Stabilization-parameters
     1  1  1
   !Boundary-patch-definitions     
     #AorticInletID  V   dirichlet   InVel
     #BC1            V   stabilized_neumann[1;#STAB] 0  0  0
     #BC2            V   stabilized_neumann[1;#STAB] 0  0  0
     #BC3            V   stabilized_neumann[1;#STAB] 0  0  0
     #Outlet         V   stabilized_neumann[1;#STAB] 0  0  0

     !DefExpression = {inlet_expr}
      2 * influx / (#pi * #AO_radius^2) * phi * #ai_nx
      2 * influx / (#pi * #AO_radius^2) * phi * #ai_ny
      2 * influx / (#pi * #AO_radius^2) * phi * #ai_nz

     !DefExpression = {ir}
       ((#inface_x)-X.1)^2 + ((#inface_y)-X.2)^2 + ((#inface_z)-X.3)^2

     !DefExpression = {phi}  
       max(0,1 - (ir/#AO_radius^2))
      
%  --- LM Problem Specifications  ------------------------------------------
  !DefProblem = {couplewall | fscoupling_problem}
    !UseVariablePointer = {Space | X}
    !Addterms
      TestVariable[V], V[#pen]  source_wall
    !Addterms
      TestVariable[P*], V[trace;0]
    !Boundary-conditions-not-required
    !SetPerturbationBuild
    !SetRootTopology = {WallTP}
    !DefExpression = {source_wall}
       -#pen * (1/#DT) * (max((P.1-#Po),-500)/#K * Norms.1 + (-X.1) + X0.1 ) 
       -#pen * (1/#DT) * (max((P.1-#Po),-500)/#K * Norms.2 + (-X.2) + X0.2 )
       -#pen * (1/#DT) * (max((P.1-#Po),-500)/#K * Norms.3 + (-X.3) + X0.3 )

  !DefProblem={couplebc1 | fscoupling_problem}
   !UseVariablePointer={Space | X}
   %!Addterms % Are these necessary?
   %  TestVariable[V], LM1[trace]
   !Addterms
     TestVariable[LM1*], V[trace], q1_expr
   !Boundary-conditions-not-required
   !SetRootTopology = {Outletbc1}

 !DefProblem={couplebc2 | fscoupling_problem}
   !UseVariablePointer={Space | X}
   %!Addterms
   %  TestVariable[V], LM2[trace]
   !Addterms
     TestVariable[LM2*], V[trace], q1_expr
   !Boundary-conditions-not-required
   !SetRootTopology = {Outletbc2}

!DefProblem={couplebc3 | fscoupling_problem}
   !UseVariablePointer={Space | X}
   %!Addterms
   %  TestVariable[V], LM3[trace]
   !Addterms
     TestVariable[LM3*], V[trace], q1_expr
   !Boundary-conditions-not-required
   !SetRootTopology = {Outletbc3}

 !DefProblem={coupleout | fscoupling_problem}
   !UseVariablePointer={Space | X}
   !Addterms
     TestVariable[V], LMOut[trace]
   !Addterms
     TestVariable[LMOut*], LMOut[R1] LMOut[dt;#C1] Po[R1neg]  V[trace;-1]
   !Boundary-conditions-not-required
   !SetRootTopology = {Outlet}
