   !SetTopology={Outletbc1 | PartitioningWeight | 100}

  !DefTopology={Outletbc2 | #meshfolder/bcout2  | LinBasis2D}
    !SetTopology={Outletbc2 | CreateInBoundary | [TP1;#BC2]}
    !SetTopology={Outletbc2 | PartitioningWeight | 100}

 !DefTopology={Outletbc3 | #meshfolder/bcout3  | LinBasis2D}
   !SetTopology={Outletbc3 | CreateInBoundary | [TP1;#BC3]}
   !SetTopology={Outletbc3 | PartitioningWeight | 100}

  !DefTopology={Outlet | #meshfolder/outlet  | LinBasis2D}
    !SetTopology={Outlet | CreateInBoundary | [TP1;#Outlet]}
    !SetTopology={Outlet | PartitioningWeight | 100}

  !DefTopology = {WallTP | #meshfolder/tpwall  | LinBasis2D}
    !SetTopology = {WallTP | CreateInBoundary | [TP1;#BCWall]}
    !SetTopology = {WallTP | PartitioningWeight | 100}

 !DefTopology={Outletbc1Const | #meshfolder/bcout1_const  | 0Basis2D}
