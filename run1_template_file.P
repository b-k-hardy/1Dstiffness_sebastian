!DefTimeStepScheme = {TimeStepping}
   1   #NO_STEPS   #DT

%
%  ---  Topologies & Basis sets  --------------------------------------------
%

%  Basis file...
 !UseBasis={LinBasis3D  | TETRAHEDRAL_ELEMENT | NODAL_LAGRANGE1 | KEAST_LYNESS4}
 !UseBasis={LinBasis2D  | TRIANGLE_ELEMENT    | NODAL_LAGRANGE1 | KEAST_LYNESS4}
 !UseBasis={0Basis2D    | TRIANGLE_ELEMENT    | NODAL_LAGRANGE0 | KEAST_LYNESS4}
 !UseBasis={DscBasis | TETRAHEDRAL_ELEMENT | NODAL_LAGRANGE0 | KEAST_LYNESS8}

%  Topologies ...
 !DefTopology={ TP1 | #meshfolder/model | LinBasis3D }

 !DefTopology={Outletbc1 | #meshfolder/bcout1  | LinBasis2D}
