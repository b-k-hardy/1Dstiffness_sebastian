
#meshfolder=meshes
#RHO=1.060e-3      % density   (units consistent with mesh)
#MU=4.0e-3         % viscosity (units consistent with mesh)
#STAB=0.212e-3     % stabilization parameter related to 0.2 * Density
#VEL_SCALE=1785.00 % Expected peak velocity (units consistent with mesh)
#DT=0.001          % time step size (should assume that this is consistent with other units... e.g. use sec)
#NO_STEPS=1000     % total number of steps to run the simulation (currently set for 1 cycle)

% patch ID labels
#AorticInletID=4
#Outlet=3
#BC1=2
#BC2=5
#BC3=6
#BCWall=1

% inward facing normal of Aorta inflow face ...
#ai_nx= -0.646591
#ai_ny= -0.00349806
#ai_nz=  0.762829
% center location of Aorta inflow face
#inface_x = 15.8087 
#inface_y = -173.83
#inface_z = 487.886
#stroke_vol = 70 % ml... not SI because mesh units are mm?
#Ts = 0.3 % when does systole end
#pi = 3.141572

% Vessel areas
#AO_area=829.973
#AO_radius=12

#A1_area=92.3186
#A2_area=30.316
#A3_area=79.9705
#Aout_area=335.702

#K = 1.0000e+04 % Pa/mm
#pen = 100000 % or try 1000000 if that doesn't work
#Po = 8.3999e+03  % Pa or 63 mmHg

#outdir=results1
!SetOutputPath={#outdir}

